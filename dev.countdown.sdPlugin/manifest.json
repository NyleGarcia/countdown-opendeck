{
  "Name": "Countdown",
  "Description": "Countdown timer with a configurable duration, progress ring, flashing alarm and sound.",
  "Author": "Zedwil",
  "Version": "0.1.0",
  "Icon": "icons/plugin",
  "Category": "Countdown",
  "CategoryIcon": "icons/plugin",
  "SDKVersion": 2,
  "CodePath": "run.sh",
  "CodePathLin": "run.sh",
  "Software": {
    "MinimumVersion": "6.0"
  },
  "OS": [
    {
      "Platform": "linux",
      "MinimumVersion": "0"
    }
  ],
  "Actions": [
    {
      "Name": "Countdown Timer",
      "UUID": "dev.countdown.timer",
      "Icon": "icons/action",
      "Tooltip": "Tap to start/pause, hold to reset. Set the duration in settings. On a dial: rotate to adjust, press to start/pause, touch to reset.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "SupportedInMultiActions": false,
      "DisableAutomaticStates": true,
      "PropertyInspectorPath": "pi/timer.html",
      "States": [
        {
          "Image": "icons/key",
          "Title": "",
          "ShowTitle": false
        }
      ],
      "Encoder": {
        "layout": "layouts/strip.json",
        "TriggerDescription": {
          "Rotate": "Adjust duration",
          "Push": "Start / pause",
          "Touch": "Reset"
        },
        "StackColor": "#3ddc84"
      }
    }
  ]
}
